        btnCompany.className = "flex items-center gap-2 px-6 py-2 rounded-full font-semibold text-sm transition-all duration-300 text-white bg-gradient-to-r from-funnGreen-600 to-funnGreen-500 shadow-md shadow-funnGreen-500/30";
        btnTeen.className = "flex items-center gap-2 px-6 py-2 rounded-full font-semibold text-sm transition-all duration-300 text-gray-400 hover:text-white";

        // Style Mobile Toggle
        mBtnCompany.className = "py-2.5 px-3 rounded-lg font-bold text-xs flex items-center justify-center gap-2 bg-funnGreen-500 text-funnDark-900";
        mBtnTeen.className = "py-2.5 px-3 rounded-lg font-bold text-xs flex items-center justify-center gap-2 text-gray-300";

        // Dynamic Text Adjustments
        navCtaText.innerText = "Hire Talent";
        ctaTitle.innerHTML = 'Ready to Work with <span class="gradient-text-green">Smart Teen Talent</span>?';
        ctaDesc.innerText = 'Join thousands of companies getting micro-tasks done faster and at lower costs.';
        ctaPrimaryBtn.innerText = 'Post a Project Now';
        ctaPrimaryBtn.className = "w-full sm:w-auto px-10 py-4 rounded-xl font-extrabold text-base bg-gradient-to-r from-funnGreen-500 to-emerald-600 hover:from-funnGreen-400 hover:to-emerald-500 text-funnDark-900 shadow-xl shadow-funnGreen-500/40 transition-all transform hover:scale-105";

      } else {
        // Toggle visibility
        teenPage.classList.remove('hidden');
        companyPage.classList.add('hidden');

        // Style Desktop Toggle
        btnTeen.className = "flex items-center gap-2 px-6 py-2 rounded-full font-semibold text-sm transition-all duration-300 text-white bg-gradient-to-r from-blue-600 to-indigo-600 shadow-md shadow-blue-500/30";
        btnCompany.className = "flex items-center gap-2 px-6 py-2 rounded-full font-semibold text-sm transition-all duration-300 text-gray-400 hover:text-white";

        // Style Mobile Toggle
        mBtnTeen.className = "py-2.5 px-3 rounded-lg font-bold text-xs flex items-center justify-center gap-2 bg-blue-500 text-white";
        mBtnCompany.className = "py-2.5 px-3 rounded-lg font-bold text-xs flex items-center justify-center gap-2 text-gray-300";

        // Dynamic Text Adjustments
        navCtaText.innerText = "Start Earning";
        ctaTitle.innerHTML = 'Ready to Earn Your <span class="gradient-text-blue">First Income</span>?';
        ctaDesc.innerText = 'Join over 100,000+ students building portfolios and earning money on Funngro.';
        ctaPrimaryBtn.innerText = 'Register as Teen Freelancer';
        ctaPrimaryBtn.className = "w-full sm:w-auto px-10 py-4 rounded-xl font-extrabold text-base bg-gradient-to-r from-blue-500 to-indigo-600 hover:from-blue-400 hover:to-indigo-500 text-white shadow-xl shadow-blue-500/40 transition-all transform hover:scale-105";
      }

      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // Mobile menu toggle logic
    function toggleMobileMenu() {
      const menu = document.getElementById('mobile-menu');
      menu.classList.toggle('hidden');
    }

    // FAQ Accordion Handler
    function toggleFaq(index) {
      const answer = document.getElementById(`faq-answer-${index}`);
      const icon = document.getElementById(`faq-icon-${index}`);

      if (answer.classList.contains('hidden')) {
        answer.classList.remove('hidden');
        icon.style.transform = 'rotate(180deg)';
      } else {
        answer.classList.add('hidden');
        icon.style.transform = 'rotate(0deg)';
      }
    }

    // Toast notification handler
    function showToast(message) {
      const toast = document.getElementById('toast');
      const toastMsg = document.getElementById('toast-msg');
      toastMsg.innerText = message;

      toast.classList.remove('translate-y-20', 'opacity-0', 'pointer-events-none');
      toast.classList.add('translate-y-0', 'opacity-100');

      setTimeout(() => {
        toast.classList.remove('translate-y-0', 'opacity-100');
        toast.classList.add('translate-y-20', 'opacity-0', 'pointer-events-none');
      }, 3500);
    }

    function handleMainCtaAction() {
      if (currentPage === 'company') {
        showToast('Opening Company Project Posting Portal...');
      } else {
        showToast('Opening Teen Registration & Assessment Portal...');
      }
    }

    function handleSecondaryCtaAction() {
      if (currentPage === 'company') {
        switchPage('teen');
        showToast('Switched to Teen Earnings view!');
      } else {
        switchPage('company');
        showToast('Switched to Company Hire view!');
      }
    }
  </script>
</body>
</html>

